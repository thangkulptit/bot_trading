# Chuỗi bí mật dùng chung với bot (MT5_BRIDGE_TOKEN bên .env của bot), ít nhất 16 ký tự
BRIDGE_TOKEN=change-me-to-a-long-random-string
# 127.0.0.1 = chỉ bot trên cùng máy gọi được (khuyến nghị)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Đường dẫn terminal64.exe (để trống nếu MT5 cài mặc định)
MT5_PATH=
# Để trống 3 dòng dưới nếu terminal MT5 đã đăng nhập sẵn tài khoản
MT5_LOGIN=
# Mật khẩu giao dịch (master), KHÔNG phải investor password
MT5_PASSWORD=
# Đúng tên server Exness, vd: Exness-MT5Trial8
MT5_SERVER=

# Magic number gắn vào lệnh của bot (phân biệt với lệnh tay)
MT5_MAGIC=20261112
# Trượt giá tối đa khi khớp lệnh (points)
MT5_DEVIATION=20
# Chênh lệch giờ server broker so với UTC: auto = tự dò từ tick, hoặc số giờ (Exness thường là 0)
MT5_SERVER_UTC_OFFSET_HOURS=auto

# ================= SERVER =================
PORT=3000
# Bắt buộc: gửi qua header x-api-key cho mọi /api/*
API_KEY=change-me-to-a-long-random-string
LOG_LEVEL=info
DATA_DIR=./data

# ================= MYSQL =================
# Bot tự tạo database (nếu DB_AUTO_CREATE=true) và các bảng orders, order_events, ai_decisions khi khởi động
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xau_bot
DB_PASSWORD=
DB_NAME=xau_bot
# Kết nối qua unix socket thay cho host/port (vd: /var/run/mysqld/mysqld.sock)
DB_SOCKET=
DB_CONNECTION_LIMIT=5
DB_AUTO_CREATE=true

# ================= GIAO DỊCH =================
# Bot phân tích và vào lệnh trên CÙNG chart XAUUSD của tài khoản Exness MT5.
# Exness đặt tên theo loại tài khoản: Pro/Raw/Zero = XAUUSD | Standard = XAUUSDm | Cent = XAUUSDc
# (npm run mt5:connect sẽ in ra tên đúng cho tài khoản của bạn)
SYMBOL=XAUUSD
# paper = mô phỏng (mặc định, an toàn) | live = đặt lệnh thật trên Exness MT5 qua MetaApi
MODE=paper
# Bắt buộc khi MODE=live
LIVE_CONFIRM=
AUTO_START=false
LOOP_INTERVAL_SEC=20
MONITOR_INTERVAL_SEC=5
PRICE_DIGITS=2

# ================= NGUỒN CHART =================
# metaapi = chart XAUUSD của chính tài khoản Exness (bắt buộc khi live; paper cũng nên dùng)
# yahoo   = GC=F miễn phí, trễ ~10 phút — chỉ để thử code (cần MAX_DATA_DELAY_SEC=1800)
DATA_SOURCE=metaapi
YAHOO_SYMBOL=GC=F
# Nến/giá cũ hơn mức này (giây) → coi là mất kết nối, không vào lệnh
MAX_DATA_DELAY_SEC=120

# ================= EXNESS MT5 qua METAAPI — https://metaapi.cloud =================
METAAPI_TOKEN=
# Lấy từ kết quả `npm run mt5:connect`
METAAPI_ACCOUNT_ID=
METAAPI_REGION=london
# Chỉ dùng cho `npm run mt5:connect` (đăng nhập MT5 lần đầu), có thể xoá sau đó
MT5_LOGIN=
# Mật khẩu giao dịch (master), KHÔNG phải investor password
MT5_PASSWORD=
# Đúng tên server trong email Exness / MT5, vd: Exness-MT5Trial8, Exness-MT5Real15
MT5_SERVER=
METAAPI_PROVISION_REGION=london

# ================= PAPER =================
PAPER_START_BALANCE=10000
PAPER_SPREAD=0.25

# ================= AI (API tương thích OpenAI) =================
# OpenAI: https://api.openai.com/v1 | DeepSeek: https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1 | Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# confirm    = chiến lược tạo tín hiệu, AI xác nhận/từ chối (khuyến nghị)
# autonomous = AI tự quyết định dựa trên context (vẫn bị risk manager chặn)
# off        = chỉ chạy theo quy tắc, không gọi AI
AI_MODE=confirm
# Tắt nếu provider không hỗ trợ response_format=json_object
AI_JSON_MODE=true
AI_MIN_CONFIDENCE=0.65
AI_MIN_INTERVAL_SEC=60
AI_TIMEOUT_MS=30000
AI_CONTEXT_MAX_CHARS=12000

# ================= QUẢN LÝ RỦI RO (AI không thể vượt qua) =================
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
# Đạt lãi này thì nghỉ hết ngày (0 = tắt)
MAX_DAILY_PROFIT_PCT=3
MAX_DAILY_TRADES=8
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_STREAK_MIN=60
MAX_OPEN_POSITIONS=1
MAX_FLOATING_LOSS_PCT=1
# Khoảng cách giá tính bằng USD (XAUUSD: 1.00 = 100 point)
MAX_SPREAD=0.5
MIN_SL=1.5
MAX_SL=6
MIN_RR=1.2
TP_RR=1.5
# 1 lot XAUUSD = 100 oz → giá chạy 1 USD = 100 USD/lot
CONTRACT_SIZE=100
MIN_LOT=0.01
LOT_STEP=0.01
MAX_LOT=1
MAX_HOLD_MIN=45
BREAKEVEN_AT_R=1
BREAKEVEN_OFFSET=0.1
TRAIL_START_R=1.3
TRAIL_ATR_MULT=1
MIN_STOP_DISTANCE=0.5

# ================= CHECKLIST ĐA KHUNG TRƯỚC KHI VÀO LỆNH =================
# Bắt buộc (hard): H1+M15 cùng xu hướng, H4 không ngược, ADX, biến động, không nến đột biến,
# RSI H1 chưa cực trị, giá chưa chạy xa, M5 hồi + nến xác nhận, M1 cùng hướng, SL/spread/khoảng trống tới vùng cản.
# Cộng điểm (soft): H4 cùng hướng, cấu trúc H1, không vướng số tròn $10, RSI M15 lành mạnh.
ADX_MIN=20
MIN_ATR_M5=0.8
MAX_ATR_M5=6
# Nến M5/M1 dài hơn X lần ATR = đột biến → chờ
SPIKE_ATR_MULT=2.5
# Giá cách EMA21 M15 quá X lần ATR M15 = đã chạy xa, không đuổi
MAX_EXTENSION_ATR_M15=1.5
# Spread tối đa = X × khoảng SL
MAX_SPREAD_SL_RATIO=0.12
# Số điều kiện soft tối thiểu phải đạt (trên 4)
MIN_SOFT_CHECKS=2
# Ngay trước khi gửi lệnh: giá trượt quá X × khoảng SL so với lúc phân tích → hủy lệnh
MAX_ENTRY_DRIFT_R=0.25

# ================= PHIÊN GIAO DỊCH (UTC) =================
# 7–20 UTC = phiên London + New York (14:00–03:00 giờ Việt Nam)
SESSION_START_UTC=7
SESSION_END_UTC=20
FRIDAY_CUTOFF_UTC=18

# ================= TIN TỨC =================
NEWS_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_CURRENCIES=USD
NEWS_BLOCK_IMPACTS=High
NEWS_BLOCK_BEFORE_MIN=30
NEWS_BLOCK_AFTER_MIN=30
# Đóng toàn bộ lệnh khi còn X phút tới tin mạnh (0 = tắt)
NEWS_CLOSE_BEFORE_MIN=5
NEWS_REFRESH_MIN=60
# Không tải được lịch tin → không vào lệnh mới
NEWS_FAILSAFE_BLOCK=true
